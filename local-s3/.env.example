# Local-only MinIO settings. Copy this file to .env when customization is needed.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3MP_LOCAL_BUCKET=s3mp-dev

# Application credentials for S3MP. Do not use the MinIO root credentials in the backend.
S3MP_ACCESS_KEY=s3mp-app
S3MP_SECRET_KEY=change-me-s3mp-local
