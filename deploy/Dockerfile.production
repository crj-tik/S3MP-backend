# Build with Compose BuildKit named context "frontend". This produces one
# application image shared by migration, bootstrap, API, worker and scheduler.
FROM node:22-alpine AS frontend-build
WORKDIR /app
COPY --from=frontend package.json package-lock.json ./
RUN npm ci
COPY --from=frontend . .
ARG VITE_APP_TITLE=S3MP 管理平台
ARG VITE_API_MODE=real
ARG VITE_APP_BASE_PATH=/
ARG VITE_API_BASE_URL=
ENV VITE_APP_TITLE=${VITE_APP_TITLE}
ENV VITE_API_MODE=${VITE_API_MODE}
ENV VITE_APP_BASE_PATH=${VITE_APP_BASE_PATH}
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN npm run build

FROM python:3.12-slim AS backend-build
# Avoid a second registry dependency (GHCR is commonly blocked or unstable on
# mainland networks).  The build-stage-only installation keeps the runtime
# image unchanged while retrieving uv from the regular Python package index.
RUN python -m pip install --no-cache-dir "uv>=0.7,<0.8"
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY src ./src
RUN uv sync --frozen --no-dev
COPY scripts ./scripts
COPY contracts ./contracts
COPY alembic.ini ./
COPY migrations ./migrations

FROM python:3.12-slim
RUN find /etc/apt -type f \( -name 'sources.list' -o -name '*.sources' \) -print0 \
    | xargs -0 sed -i \
        -e 's|http://deb.debian.org/debian|https://mirrors.aliyun.com/debian|g' \
        -e 's|http://deb.debian.org/debian-security|https://mirrors.aliyun.com/debian-security|g' \
        -e 's|https://deb.debian.org/debian|https://mirrors.aliyun.com/debian|g' \
        -e 's|https://deb.debian.org/debian-security|https://mirrors.aliyun.com/debian-security|g' \
    && apt-get update \
    && apt-get install -y --no-install-recommends nginx supervisor \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default
WORKDIR /app
COPY --from=backend-build /app /app
COPY deploy/entrypoint.sh /usr/local/bin/s3mp-entrypoint
COPY deploy/nginx.application.conf /etc/nginx/conf.d/default.conf
COPY deploy/supervisord.application.conf /etc/supervisor/conf.d/s3mp.conf
COPY --from=frontend-build /app/dist /usr/share/nginx/html
RUN chmod +x /usr/local/bin/s3mp-entrypoint
ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 80
ENTRYPOINT ["/usr/local/bin/s3mp-entrypoint"]
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/supervisord.conf"]
