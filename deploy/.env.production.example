# Copy outside the repository, for example to /opt/s3mp/s3mp.env, then use:
# docker compose --env-file /opt/s3mp/s3mp.env -f deploy/compose.production.yaml …
# Keep this file owner-readable only: chmod 600 /opt/s3mp/s3mp.env
S3MP_HTTP_PORT=8080
VITE_APP_TITLE=S3MP 管理平台
# Leave the defaults for a dedicated subdomain. For https://example.com/s3mp/, use /s3mp/ and /s3mp.
VITE_APP_BASE_PATH=/
VITE_API_BASE_URL=
S3MP_LOG_LEVEL=INFO
# PostgreSQL/Redis are managed by Compose. Passwords in the URLs must be URL-encoded.
S3MP_POSTGRES_PASSWORD=<postgres-raw-password>
S3MP_REDIS_PASSWORD=<redis-raw-password>
S3MP_DATABASE_URL=postgresql+asyncpg://s3mp:<postgres-url-encoded-password>@postgres:5432/s3mp
S3MP_REDIS_URL=redis://:<redis-url-encoded-password>@redis:6379/0
# Online S3-compatible service. The bucket and credentials must be provisioned before deployment.
S3MP_S3_ENDPOINT=https://s3.example.com
S3MP_S3_REGION=us-east-1
S3MP_S3_PATH_STYLE=false
S3MP_S3_BUCKET=your-production-bucket
S3MP_S3_BUCKET_CAPACITY_GIB=100
S3MP_S3_ACCESS_KEY=<s3-access-key>
S3MP_S3_SECRET_KEY=<s3-secret-key>
S3MP_API_KEY_PEPPER=<at-least-32-random-bytes>
S3MP_API_KEY_PEPPER_VERSION=1
# Tag of the single application image. Use a fully qualified ACR image name
# when the server pulls it from Alibaba Cloud Container Registry.
S3MP_APP_IMAGE=s3mp:latest
# First platform administrator.
S3MP_BOOTSTRAP_ADMIN_ENABLED=true
S3MP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
S3MP_BOOTSTRAP_ADMIN_EMPLOYEE_NUMBER=admin
S3MP_BOOTSTRAP_ADMIN_DISPLAY_NAME=Platform Administrator
S3MP_BOOTSTRAP_ADMIN_PASSWORD=<first-admin-password>
