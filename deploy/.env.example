# Optional overrides for commands run outside Compose.
S3MP_ENVIRONMENT=development
S3MP_LOG_LEVEL=INFO
# Docker containers must use localhost rather than localhost to
# reuse the existing Windows-host PostgreSQL and Redis instances.
S3MP_DOCKER_DATABASE_URL=postgresql+asyncpg://<user>:<password>@host.docker.internal:18110/s3mp
S3MP_DOCKER_REDIS_URL=redis://:<password>@host.docker.internal:18113/0
S3MP_READINESS_TIMEOUT_SECONDS=2
S3MP_DOCKER_S3_ENDPOINT=http://host.docker.internal:9000
S3MP_S3_REGION=us-east-1
# 使用 AWS 兼容端点或 MinIO 时保持 true；仅当生产对象存储明确支持虚拟主机风格时设为 false。
S3MP_S3_PATH_STYLE=true
S3MP_S3_BUCKET=s3mp-dev
S3MP_S3_BUCKET_CAPACITY_GIB=<shared-bucket-capacity-in-gib>
S3MP_S3_ACCESS_KEY=<minio-access-key>
S3MP_S3_SECRET_KEY=<minio-secret-key>
S3MP_API_KEY_PEPPER=<at-least-32-random-bytes>
# Optional values used only by `deploy/compose.managed-infra.yaml`.
S3MP_MANAGED_POSTGRES_PASSWORD=<postgres-password>
S3MP_MANAGED_DATABASE_URL=postgresql+asyncpg://s3mp:<postgres-password>@postgres:5432/s3mp
S3MP_MANAGED_REDIS_URL=redis://redis:6379/0
