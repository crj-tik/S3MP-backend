# Optional overrides for commands run outside Compose.
S3MP_ENVIRONMENT=development
S3MP_LOG_LEVEL=INFO
# Container logs are one JSON object per line. Set text only for local readability.
S3MP_LOG_FORMAT=json
# Repository/Redis/MinIO calls slower than this emit a warning diagnostic.
S3MP_LOG_SLOW_OPERATION_MS=500
# PostgreSQL and Redis are managed by deploy/compose.yaml. These passwords are
# also embedded in runtime URLs, so use URL-safe characters only.
S3MP_POSTGRES_PASSWORD=<postgres-password>
S3MP_REDIS_PASSWORD=<redis-password>
S3MP_RABBITMQ_USER=s3mp_app
S3MP_RABBITMQ_PASSWORD=<rabbitmq-password>
S3MP_READINESS_TIMEOUT_SECONDS=2
S3MP_DOCKER_S3_ENDPOINT=http://host.docker.internal:9000
S3MP_S3_REGION=us-east-1
# 使用 AWS 兼容端点或 MinIO 时保持 true；仅当生产对象存储明确支持虚拟主机风格时设为 false。
S3MP_S3_PATH_STYLE=true
S3MP_S3_BUCKET=s3mp-dev
S3MP_S3_BUCKET_CAPACITY_GIB=<shared-bucket-capacity-in-gib>
S3MP_WORKER_RETENTION_DAYS=90
S3MP_S3_ACCESS_KEY=<minio-access-key>
S3MP_S3_SECRET_KEY=<minio-secret-key>
S3MP_API_KEY_PEPPER=<at-least-32-random-bytes>
# Knowledge extraction is enabled by default. Configure one approved OpenAI-compatible endpoint.
S3MP_KNOWLEDGE_EXTRACTION_ENABLED=true
S3MP_KNOWLEDGE_LLM_PROVIDER=deepseek
S3MP_KNOWLEDGE_LLM_MODEL=<model-name>
S3MP_KNOWLEDGE_LLM_BASE_URL=<https://approved-model-endpoint/v1>
S3MP_KNOWLEDGE_LLM_API_KEY=<secret>
S3MP_ELASTICSEARCH_URL=http://elasticsearch:9200
S3MP_ELASTICSEARCH_API_KEY=
S3MP_KNOWLEDGE_ELASTICSEARCH_INDEX=s3mp-knowledge-cards-v1
# Optional CAS browser login. Keep disabled until the callback URL is registered.
S3MP_CAS_ENABLED=false
S3MP_CAS_LOGIN_URL=
S3MP_CAS_VALIDATE_URL=
S3MP_CAS_SERVICE_URL=
S3MP_CAS_ISSUER=
S3MP_CAS_SESSION_HOST=
S3MP_CAS_SESSION_SOURCE=
S3MP_CAS_SESSION_SIGNATURE=<session-service-signature>
# Optional CAS global logout. Ask the CAS owner for the logout URL, callback parameter name,
# and whether this exact return URL needs to be registered.
S3MP_CAS_LOGOUT_URL=
S3MP_CAS_LOGOUT_RETURN_URL=
S3MP_CAS_LOGOUT_RETURN_PARAMETER=service
# Optional first administrator. The bootstrap service is idempotent: it only
# creates this account if no active platform administrator exists.
S3MP_BOOTSTRAP_ADMIN_ENABLED=false
S3MP_BOOTSTRAP_ADMIN_EMAIL=
S3MP_BOOTSTRAP_ADMIN_EMPLOYEE_NUMBER=
S3MP_BOOTSTRAP_ADMIN_DISPLAY_NAME=
S3MP_BOOTSTRAP_ADMIN_PASSWORD=
# Legacy optional topology in deploy/compose.managed-infra.yaml.
S3MP_MANAGED_POSTGRES_PASSWORD=<postgres-password>
S3MP_MANAGED_DATABASE_URL=postgresql+asyncpg://s3mp:<postgres-password>@postgres:5432/s3mp
S3MP_MANAGED_REDIS_URL=redis://redis:6379/0
S3MP_MANAGED_RABBITMQ_URL=amqp://s3mp_app:<rabbitmq-password>@rabbitmq:5672/%2F
