# Optional overrides for commands run outside Compose.
S3MP_ENVIRONMENT=development
S3MP_LOG_LEVEL=INFO
S3MP_DATABASE_URL_FILE=deploy/secrets.example/database_url
S3MP_REDIS_URL=redis://localhost:6379/0
S3MP_READINESS_TIMEOUT_SECONDS=2
# Production requires both S3MP_DATABASE_URL_FILE and S3MP_REDIS_URL_FILE.
