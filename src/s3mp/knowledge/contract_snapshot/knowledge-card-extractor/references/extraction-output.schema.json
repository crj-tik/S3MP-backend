{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ke:knowledge:local-directory-extraction-output:2.0",
  "$comment": "作者: cuiyang。本地知识目录批量提取输出契约；卡片字段仍以打包的 ontology/schema.yaml 为准。",
  "title": "Local Directory Knowledge Extraction Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "batch",
    "sources",
    "cards",
    "unresolved",
    "conflicts",
    "ontologyProposals",
    "validation"
  ],
  "properties": {
    "schemaVersion": {"const": "2.0"},
    "batch": {"$ref": "#/$defs/batch"},
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    },
    "cards": {
      "type": "array",
      "items": {"$ref": "#/$defs/cardDraft"}
    },
    "unresolved": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    },
    "conflicts": {
      "type": "array",
      "items": {"$ref": "#/$defs/conflict"}
    },
    "ontologyProposals": {
      "type": "array",
      "items": {"$ref": "#/$defs/ontologyProposal"}
    },
    "validation": {"$ref": "#/$defs/validation"}
  },
  "$defs": {
    "cardType": {
      "type": "string",
      "enum": ["metric", "table", "concept", "policy", "attribution", "equation", "action", "org", "tool"]
    },
    "batch": {
      "type": "object",
      "additionalProperties": true,
      "required": ["batchId", "sourceRoot", "outputRoot", "cardsRoot", "reportsRoot", "createdAt", "contract"],
      "properties": {
        "batchId": {"type": "string", "minLength": 1},
        "sourceRoot": {"type": "string", "minLength": 1},
        "outputRoot": {"type": "string", "minLength": 1},
        "cardsRoot": {"type": "string", "minLength": 1},
        "reportsRoot": {"type": "string", "minLength": 1},
        "createdAt": {"type": "string", "format": "date-time"},
        "contract": {"type": "object"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["sourceId", "relativePath", "localPath", "uri", "status"],
      "properties": {
        "sourceId": {"type": "string", "pattern": "^source::[a-f0-9]{16}$"},
        "relativePath": {"type": "string", "minLength": 1},
        "localPath": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "pattern": "^file://"},
        "status": {"enum": ["ready", "skipped", "error"]},
        "reason": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "sizeBytes": {"type": ["integer", "null"], "minimum": 0},
        "mediaType": {"type": ["string", "null"]},
        "lastModified": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "sourceLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "recordId"],
      "properties": {
        "sourceId": {"type": "string", "pattern": "^source::[a-f0-9]{16}$"},
        "recordId": {"type": "string", "minLength": 1},
        "heading": {"type": ["string", "null"]},
        "page": {"type": ["integer", "null"], "minimum": 1},
        "quote": {"type": ["string", "null"]}
      }
    },
    "cardDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "status", "provenance", "changeMode", "relativeOutputPath", "frontmatter", "content", "sourceLocations", "confidence"],
      "properties": {
        "type": {"$ref": "#/$defs/cardType"},
        "id": {"type": "string", "minLength": 1},
        "status": {"const": "draft"},
        "provenance": {"const": "ai_extracted"},
        "changeMode": {"enum": ["create", "update", "duplicate_candidate"]},
        "relativeOutputPath": {"type": "string", "minLength": 1},
        "frontmatter": {"type": "object"},
        "content": {"type": "string"},
        "sourceLocations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceLocation"}
        },
        "confidence": {"enum": ["high", "medium", "low"]},
        "reviewRequired": {"type": "boolean", "default": true}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "metric"}}, "required": ["type"]},
          "then": {"properties": {"id": {"pattern": "^metric::[0-9]+$"}}}
        },
        {
          "if": {"properties": {"type": {"const": "table"}}, "required": ["type"]},
          "then": {"properties": {"id": {"pattern": "^table/[a-z0-9_.-]+$"}}}
        },
        {
          "if": {"properties": {"type": {"enum": ["concept", "policy", "attribution", "equation", "action", "org", "tool"]}}, "required": ["type"]},
          "then": {"properties": {"id": {"pattern": "^(concept|policy|attribution|equation|action|org|tool)/[a-z0-9-]+$"}}}
        }
      ]
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "severity"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "severity": {"enum": ["error", "warning"]},
        "sourceId": {"type": ["string", "null"]},
        "recordId": {"type": ["string", "null"]},
        "cardId": {"type": ["string", "null"]},
        "field": {"type": ["string", "null"]},
        "ownerRole": {"type": ["string", "null"]}
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateCardId", "existingCardId", "field", "sourceValue", "existingValue", "sourceIds"],
      "properties": {
        "candidateCardId": {"type": "string", "minLength": 1},
        "existingCardId": {"type": "string", "minLength": 1},
        "field": {"type": "string", "minLength": 1},
        "sourceValue": {},
        "existingValue": {},
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "recommendation": {"type": ["string", "null"]}
      }
    },
    "ontologyProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attribute", "proposedValue", "reason", "sourceIds", "approvalStatus"],
      "properties": {
        "attribute": {"type": "string", "minLength": 1},
        "proposedValue": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "affectedCardTypes": {
          "type": "array",
          "items": {"$ref": "#/$defs/cardType"}
        },
        "approvalStatus": {"const": "pending"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "valid", "errors", "warnings", "duplicateCardIds", "brokenReferences"],
      "properties": {
        "status": {"enum": ["pending", "passed", "failed"]},
        "valid": {"type": "boolean"},
        "errors": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
        "warnings": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
        "duplicateCardIds": {"type": "array", "items": {"type": "string"}},
        "brokenReferences": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
